<%- partial('partial/head') %>
  <%- partial('partial/header') %>

    <%- partial('partial/hero') %>

      <%- partial('partial/intro') %>

        <%- partial('partial/commission-status') %>

          <% var homePlans=theme.commission_plans || []; %>
            <% if (homePlans.length) { %>
              <section class="home-sec">
                <div class="home-side rv">
                  <h2>訂製一份故事 — Commission</h2>
                  <p>文字委託</p>
                  <p>「如果你心裡也有一個想被寫下的故事，歡迎把它交給我。我會認真聽，再慢慢替它找到合適的文字。」</p>
                  <a class="btn-text" href="<%- url_for('/commission/') %>">看完整菜單與排程</a>
                </div>
                <div class="home-main">
                  <% homePlans.forEach(function(p, i){ %>
                    <div class="menu-row rv" data-t="<%= p.key %>" style="--d:<%= i %>">
                      <div class="menu-top">
                        <svg class="fl" width="22" height="22" aria-hidden="true">
                          <use href="#flw" />
                        </svg>
                        <span class="menu-nm">
                          <%= p.name %>
                        </span>
                        <span class="menu-ld"></span>
                        <span class="menu-pr">
                          <%= String(p.price).replace('/', ' / ' ) %>
                        </span>
                      </div>
                      <p class="menu-ds">
                        <% if (p.range && String(p.range).trim() !=='-' ) { %>
                          <%= p.range %>　<% } %>
                              <%= p.note %>
                      </p>
                    </div>
                    <% }) %>
                </div>
              </section>
              <% } %>

                <% // 置頂文章一律排在最前面（彼此之間仍依日期新到舊），其餘文章維持原本的日期排序， // 最後才截斷到要顯示的篇數，確保置頂文章不會被排擠出「最近寫的字」。 var
                  recentPosts=site.posts.filter(function(p){ return !p.also_copy;
                  }).sort('-date').toArray().sort(function(a, b){ return (b.pin ? 1 : 0) - (a.pin ? 1 : 0); }).slice(0,
                  theme.recent_count || 6); %>
                  <section class="home-sec">
                    <div class="home-side rv">
                      <h2>今日櫥窗 — Featured Stories</h2>
                      <p>近期作品展示</p>
                      <p>「最近新出爐的小故事，想把它們放進櫥窗裡，等一個有緣人來看看。」</p>
                    </div>
                    <div class="home-main">
                      <div class="diary">
                        <% recentPosts.forEach(function(post, i){ %>
                          <a class="diary-item rv" href="<%- url_for(post.path) %>" style="--d:<%= i %>">
                            <div class="diary-date">
                              <%= date(post.date, 'MM.DD' ) %>
                            </div>
                            <div class="diary-body">
                              <% if (post.pin) { %><span class="pin-badge"><span class="dot"></span>置頂</span>
                                <% } %>
                                  <% if (post.categories && post.categories.length) { %>
                                    <span class="tag">
                                      <%= post.categories.data[0].name %>
                                    </span>
                                    <% } %>
                                      <h3>
                                        <%= post.title %>
                                      </h3>
                                      <% if (post.description) { %>
                                        <p>
                                          <%= post.description %>
                                        </p>
                                        <% } else { %>
                                          <p><%- strip_html(post.excerpt || post.content).substring(0, 60) %>…</p>
                                          <% } %>
                            </div>
                          </a>
                          <% }) %>
                            <% if (site.posts.length===0) { %>
                              <p class="empty-note">故事，未完待續。</p>
                              <% } %>
                      </div>
                    </div>
                  </section>

                  <%- partial('partial/footer') %>