<%
  // 跟 project-group.ejs 完全一樣的資料邏輯：找出這個企劃的設定，
  // 並過濾出分類為「企劃」且 project_group 對應的文章。
  var group = theme.project_groups.find(function(g){ return g.key === page.group_key; }) || {};
  var themeClass = group.theme === 'moon' ? 'pc-moon' : 'pc-lamp';
  var posts = site.posts.filter(function(p){
    return p.categories && p.categories.map(function(c){ return c.name; }).indexOf('企劃') !== -1
      && p.project_group === page.group_key;
  }).sort('-date').toArray().sort(function(a, b){
    return (b.pin ? 1 : 0) - (a.pin ? 1 : 0);
  });

  var gacha = site.data['shiguangqian'] || {};
  var drawItems = gacha.items || [];
%>
<%- partial('partial/head') %>
  <%- partial('partial/header') %>

    <div class="archive-page <%= themeClass %>">
      <div class="pg-head">
        <span class="pc-dot"></span>
        <div class="section-title" style="margin:0;"><%= group.name || page.title %></div>
        <% if (group.badge) { %><span class="pc-badge"><%= group.badge %></span><% } %>
      </div>

      <% if (group.intro) { %>
        <p class="archive-intro" style="margin-top:14px;"><%= group.intro %></p>
      <% } %>
      <% if (group.status) { %>
        <p class="pc-status" style="display:block; text-align:center; margin-top:6px;"><%= group.status %></p>
      <% } %>

      <!-- ===== 抽籤卡 ===== -->
      <div class="draw-scene">
        <svg class="draw-backdrop" viewBox="0 0 520 620" aria-hidden="true">
          <defs>
            <radialGradient id="ds-glow" cx="260" cy="300" r="160" gradientUnits="userSpaceOnUse">
              <stop offset="0" class="ds-glow-stop" stop-opacity=".22"/><stop offset="1" class="ds-glow-stop" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <circle cx="260" cy="300" r="160" fill="url(#ds-glow)"/>
          <ellipse class="ds-shadow" cx="260" cy="566" rx="120" ry="6"/>
          <line class="ds-ground" x1="90" y1="574" x2="430" y2="574"/>
          <path class="ds-trail" d="M62 520 C40 430 92 340 70 196"/>
          <path class="ds-trail" d="M468 540 C500 450 452 390 480 346"/>
          <g class="ds-star ds-twinkle">
            <path d="M70 170Q70 182 82 182Q70 182 70 194Q70 182 58 182Q70 182 70 171Z"/>
            <path style="animation-delay:.9s" d="M452 120Q452 128 460 128Q452 128 452 136Q452 128 444 128Q452 128 452 121Z"/>
            <path style="animation-delay:1.8s" d="M482 322Q482 332 492 332Q482 332 482 342Q482 332 472 332Q482 332 482 323Z"/>
            <path style="animation-delay:2.7s" d="M46 448Q46 454 52 454Q46 454 46 460Q46 454 40 454Q46 454 46 449Z"/>
            <path style="animation-delay:1.3s" d="M436 506Q436 514 444 514Q436 514 436 522Q436 514 428 514Q436 514 436 507Z"/>
            <path style="animation-delay:2.2s" d="M104 96Q104 100 108 100Q104 100 104 104Q104 100 100 100Q104 100 104 97Z"/>
          </g>
          <g class="ds-stray"><circle cx="40" cy="60" r="1.2"/><circle cx="150" cy="40" r="1"/><circle cx="380" cy="50" r="1.3"/><circle cx="500" cy="200" r="1"/><circle cx="30" cy="300" r="1.2"/><circle cx="490" cy="440" r="1"/><circle cx="110" cy="590" r="1.2"/><circle cx="410" cy="600" r="1"/><circle cx="20" cy="520" r="1"/></g>
        </svg>

        <div class="draw-stage">
          <div class="draw-card" id="draw-card">
            <div class="draw-face draw-face-front">
              <span class="draw-corner tl"></span><span class="draw-corner tr"></span><span class="draw-corner bl"></span><span class="draw-corner br"></span>
              <svg class="draw-mark" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M38 12 A21 21 0 1 0 38 52 A17 17 0 0 1 38 12Z" fill="currentColor" fill-opacity=".9"/>
                <path d="M50 18Q50 25 57 25Q50 25 50 32Q50 25 43 25Q50 25 50 18Z" fill="currentColor"/>
                <circle cx="50" cy="46" r="1.6" fill="currentColor"/>
              </svg>
              <div class="draw-hint">尚未揭曉</div>
            </div>
            <div class="draw-face draw-face-back">
              <span class="draw-corner tl"></span><span class="draw-corner tr"></span><span class="draw-corner bl"></span><span class="draw-corner br"></span>
              <div class="draw-code" id="draw-code">I</div>
              <span class="draw-orientation" id="draw-orientation">正位</span>
              <div class="draw-mood" id="draw-mood"></div>
              <div class="draw-clue" id="draw-clue"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="draw-controls">
        <button class="gacha-cta solid" id="draw-btn" type="button">抽籤</button>
        <button class="gacha-cta" id="draw-copy-btn" type="button">複製籤文</button>
      </div>
      <p class="draw-pool-note" id="draw-pool-note"></p>

      <% if (gacha.cta_note) { %><p class="archive-intro" style="margin-top:36px;"><%= gacha.cta_note %></p><% } %>
      <% if (gacha.free_note) { %><p class="pc-status" style="display:block; text-align:center; margin-top:6px;"><%= gacha.free_note %></p><% } %>

      <!-- ===== 這個企劃已經寫出來的故事 ===== -->
      <% if (posts.length > 0) { %>
        <div class="section-title">— 被拾起的故事 —</div>
      <% } %>
      <div class="diary" style="margin-top:14px;">
        <% posts.forEach(function(post){ %>
          <a class="diary-item" href="<%- url_for(post.path) %>">
            <div class="diary-date"><%= date(post.date, 'MM.DD') %></div>
            <div class="diary-body">
              <% if (post.pin) { %><span class="pin-badge"><span class="dot"></span>置頂</span><% } %>
              <% if (post.is_series && post.status) { %><span class="tag"><%= post.status %></span><% } %>
              <h3><%= post.title %></h3>
              <% if (post.description) { %>
                <p><%= post.description %></p>
              <% } else { %>
                <p><%- strip_html(post.excerpt || post.content).substring(0, 60) %>…</p>
              <% } %>
            </div>
          </a>
        <% }) %>
        <% if (posts.length === 0) { %>
          <p style="color:var(--mist-dim); font-size:13px; text-align:center;">故事，未完待續。</p>
        <% } %>
      </div>

      <a class="back-link" href="<%- url_for('/projects/') %>">← 回到企劃</a>
    </div>

  <%- partial('partial/footer') %>

<script>
(function(){
  var items = <%- JSON.stringify(drawItems) %>;
  if (!items.length) return;

  // 每天最多抽 2 次（本瀏覽器內計算，不是全站共享的次數 —— 細節見交付說明）
  var DAILY_LIMIT = 2;
  var STORAGE_KEY = 'fuya-object-gacha-quota';

  var card = document.getElementById('draw-card');
  var drawBtn = document.getElementById('draw-btn');
  var copyBtn = document.getElementById('draw-copy-btn');
  var codeEl = document.getElementById('draw-code');
  var orientationEl = document.getElementById('draw-orientation');
  var moodEl = document.getElementById('draw-mood');
  var clueEl = document.getElementById('draw-clue');
  var poolNote = document.getElementById('draw-pool-note');
  var lastResultText = '';

  function toRoman(num){
    var map = [[1000,'M'],[900,'CM'],[500,'D'],[400,'CD'],[100,'C'],[90,'XC'],
      [50,'L'],[40,'XL'],[10,'X'],[9,'IX'],[5,'V'],[4,'IV'],[1,'I']];
    var res = '';
    map.forEach(function(pair){
      while (num >= pair[0]) { res += pair[1]; num -= pair[0]; }
    });
    return res;
  }

  function todayStr(){
    try {
      return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Taipei' }).format(new Date());
    } catch (e) {
      return new Date().toISOString().slice(0, 10);
    }
  }

  function loadQuota(){
    try {
      var raw = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (raw && raw.date === todayStr()) return raw.count;
    } catch (e) {}
    return 0;
  }

  function saveQuota(count){
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ date: todayStr(), count: count }));
    } catch (e) {}
  }

  var drawCount = loadQuota();

  function updateQuotaUI(){
    var remaining = DAILY_LIMIT - drawCount;
    if (remaining > 0) {
      poolNote.textContent = '今日還能抽 ' + remaining + ' 次';
      poolNote.classList.remove('is-full');
      drawBtn.disabled = false;
    } else {
      poolNote.textContent = '今日已抽滿，明天再來';
      poolNote.classList.add('is-full');
      drawBtn.disabled = true;
    }
  }
  updateQuotaUI();

  function drawFace(){
    var itemIndex = Math.floor(Math.random() * items.length);
    var item = items[itemIndex];
    var isUpright = Math.random() < 0.5;
    var mood = isUpright ? item.upright : item.reversed;

    codeEl.textContent = toRoman(itemIndex + 1);
    orientationEl.textContent = isUpright ? '正位' : '逆位';
    orientationEl.className = 'draw-orientation ' + (isUpright ? 'upright' : 'reversed');
    moodEl.textContent = mood;
    clueEl.textContent = item.clue;
    card.classList.add('flipped');

    lastResultText = '【拾光籤】' + toRoman(itemIndex + 1) + '　' + (isUpright ? '正位' : '逆位') + '：' + mood + '\n' + item.clue;

    drawCount++;
    saveQuota(drawCount);
    updateQuotaUI();
  }

  drawBtn.addEventListener('click', function(){
    if (drawCount >= DAILY_LIMIT) return;
    if (card.classList.contains('flipped')) {
      card.classList.remove('flipped');
      setTimeout(drawFace, 350);
    } else {
      drawFace();
    }
  });

  copyBtn.addEventListener('click', function(){
    if (!lastResultText) return;
    function done(){
      var original = '複製籤文';
      copyBtn.textContent = '已複製';
      setTimeout(function(){ copyBtn.textContent = original; }, 1800);
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(lastResultText).then(done).catch(function(){
        copyBtn.textContent = '請手動複製';
      });
    } else {
      try {
        var ta = document.createElement('textarea');
        ta.value = lastResultText;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        done();
      } catch (e) {
        copyBtn.textContent = '請手動複製';
      }
    }
  });
})();
</script>
