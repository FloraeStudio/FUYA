<%
  var cats = (page.categories && page.categories.length) ? page.categories.data.map(function(c){ return c.name; }) : [];
  var catName = cats[0] || '';
  var workCats = ['轉蛋', '企劃', '委託'];
  var srcCat = cats.filter(function(n){ return workCats.indexOf(n) !== -1; })[0] || '';
  var isWork = !!srcCat;
  var catClass = { '轉蛋': 'c-egg', '企劃': 'c-proj', '委託': 'c-comm' }[srcCat] || '';

  // 提醒標籤（notices）不再顯示，資料保留在文章檔案裡，之後跟標籤整合時再處理。
  var validTags = (page.tags && page.tags.length) ? page.tags.filter(function(t){ return t && t.name && t.name.trim(); }) : [];
  var validLinks = (page.links && page.links.length) ? page.links.filter(function(l){ return l && l.url && l.url.trim(); }) : [];
  var showStatusBadge = page.status && (catName !== '企劃' || page.is_series);

  // 上一篇、下一篇：只在作品之間走（依日期，上一篇是比較早寫的）
  var prevPost = null, nextPost = null;
  if (isWork) {
    var ordered = site.posts.filter(function(p){
      return (p.categories || []).some(function(c){ return workCats.indexOf(c.name) !== -1; });
    }).sort('date').toArray();
    var idx = -1;
    ordered.forEach(function(p, i){ if (p.path === page.path) idx = i; });
    if (idx > 0) prevPost = ordered[idx - 1];
    if (idx > -1 && idx < ordered.length - 1) nextPost = ordered[idx + 1];
  }

  // 回到上一層總覽
  var backHref = '/';
  var backLabel = '回到首頁';
  if (isWork) { backHref = '/works/'; backLabel = '作品展示'; }
  else if (catName && theme.nav) {
    var navEntry = theme.nav.find(function(n){ return n.name === catName; });
    if (navEntry && navEntry.slug) { backHref = '/' + navEntry.slug + '/'; backLabel = catName; }
  }
%>
<%- partial('partial/head') %>
  <%- partial('partial/header') %>

    <article class="post-detail">
      <a class="back-link" href="<%- url_for(backHref) %>">← <%= backLabel %></a>

      <div class="post-meta <%= catClass %>">
        <svg width="20" height="20" aria-hidden="true"><use href="#flw"/></svg>
        <% if (catName) { %><span><%= catName %></span><% } %>
        <span class="post-date"><%= date(page.date, 'YYYY.MM.DD') %></span>
        <% if (showStatusBadge) { %><span class="post-status"><%= page.status %></span><% } %>
      </div>

      <h1 class="post-title"><%= page.title %></h1>

      <% if (validTags.length) { %>
        <div class="post-tags <%= catClass %>">
          <% validTags.forEach(function(tag){ %>
            <a class="tag-pill" href="<%- url_for(tag.path) %>"><%= tag.name %></a>
          <% }) %>
        </div>
      <% } %>

      <div class="post-content">
        <%- page.content %>
      </div>

      <div class="post-end" aria-hidden="true">
        <svg width="18" height="18"><use href="#flw"/></svg><svg width="18" height="18"><use href="#flw"/></svg><svg width="18" height="18"><use href="#flw"/></svg>
      </div>

      <% if (validLinks.length) { %>
        <p class="post-links">
          <span>相關連結</span>
          <% validLinks.forEach(function(l){ %>
            <a href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><%= l.label || l.url %> ↗</a>
          <% }) %>
        </p>
      <% } %>

      <% if (prevPost || nextPost) { %>
        <nav class="post-adj" aria-label="上一篇與下一篇">
          <% if (prevPost) { %>
            <a class="adj prev" href="<%- url_for(prevPost.path) %>"><span class="adj-l">← 上一篇</span><span class="adj-t"><%= prevPost.title %></span></a>
          <% } else { %><span></span><% } %>
          <% if (nextPost) { %>
            <a class="adj next" href="<%- url_for(nextPost.path) %>"><span class="adj-l">下一篇 →</span><span class="adj-t"><%= nextPost.title %></span></a>
          <% } %>
        </nav>
      <% } %>

      <% if (isWork) { %>
        <div class="post-cta">
          <div>
            <h2>想要一篇屬於你的故事？</h2>
            <p>原創、夢向、二創都可以委託。</p>
          </div>
          <a class="cta-btn" href="<%- url_for('/commission/') %>">看委託菜單</a>
        </div>
      <% } %>
    </article>

    <%- partial('partial/footer') %>
