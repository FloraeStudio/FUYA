<%- partial('partial/head') %>
  <%- partial('partial/header') %>

    <div class="post-detail">
      <div class="eyebrow">
        <%= date(page.date, 'YYYY.MM.DD' ) %>
          <% if (page.categories && page.categories.length) { %> · <%= page.categories.data[0].name %>
              <% } %>
      </div>

      <h1 class="post-title">
        <%= page.title %>
      </h1>

      <%
        // 企劃分類的狀態徽章只在勾選「是連載作品」時顯示；
        // 委託等其他分類的狀態沒有 is_series 這個概念，維持原本行為（有填就顯示）。
        var catName = (page.categories && page.categories.length) ? page.categories.data[0].name : '';
        var showStatusBadge = page.status && (catName !== '企劃' || page.is_series);
      %>
      <% if (showStatusBadge) { %>
        <span class="star-badge">
          <%= page.status %>
        </span>
        <% } %>

          <%
            // 逐一過濾掉空白內容，確保「有欄位但內容是空的」不會留下一個空殼容器。
            var validTags = (page.tags && page.tags.length) ? page.tags.filter(function(t){ return t && t.name && t.name.trim(); }) : [];
            // notices 可能是 CMS 產生的 {text: '...'} 物件，也可能是手動編輯 frontmatter 時
            // 直接寫的純字串陣列 — 兩種格式都要能顯示，取文字時一併處理。
            var validNotices = (page.notices && page.notices.length)
              ? page.notices
                  .map(function(n){ return (typeof n === 'string') ? n : (n && n.text); })
                  .filter(function(t){ return t && t.trim(); })
              : [];
            var validLinks = (page.links && page.links.length) ? page.links.filter(function(l){ return l && l.url && l.url.trim(); }) : [];
          %>

          <% if (validTags.length) { %>
            <div class="post-tags">
              <% validTags.forEach(function(tag){ %>
                <a class="tag-pill" href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
              <% }) %>
            </div>
          <% } %>

          <% if (validNotices.length) { %>
            <div class="post-notices">
              <% validNotices.forEach(function(text){ %>
                <p>※<%= text %></p>
              <% }) %>
            </div>
          <% } %>

          <% if (validLinks.length) { %>
            <div class="post-links">
              <% validLinks.forEach(function(l){ %>
                <a href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><%= l.label || l.url %> ↗</a>
              <% }) %>
            </div>
          <% } %>

          <div class="post-content">
            <%- page.content %>
          </div>

          <%
            // 回到上一層總覽，而不是一律回首頁：依文章分類對應到 theme.nav
            // 裡設定好的 slug（跟導覽列/星座共用同一份設定，不用另外維護）。
            var backHref = '/';
            var backLabel = '回到首頁';
            if (catName && theme.nav) {
              var navEntry = theme.nav.find(function(n){ return n.name === catName; });
              if (navEntry && navEntry.slug) {
                backHref = '/' + navEntry.slug + '/';
                backLabel = '回到' + catName + '總覽';
              }
            }
          %>
          <a class="back-link" href="<%- url_for(backHref) %>">← <%= backLabel %></a>
    </div>

    <%- partial('partial/footer') %>
