<%
  // 依網址第一段判斷目前是哪個分類頁（企劃/轉蛋/委託/雜談），
  // 分派到對應的 partial；archives/ 這類非分類頁則用下面的通用列表。
  var slug = (page.path || '').split('/')[0];
%>
<%- partial('partial/head') %>
  <%- partial('partial/header') %>

    <div class="archive-page">
      <% if (slug === 'gacha') { %>
        <%- partial('partial/archive-gacha') %>
      <% } else if (slug === 'commission') { %>
        <%- partial('partial/archive-commission') %>
      <% } else if (slug === 'misc') { %>
        <%- partial('partial/archive-misc') %>
      <% } else if (slug === 'projects') { %>
        <%- partial('partial/archive-projects') %>
      <% } else { %>
        <%
          var sorted = page.posts.sort('-date');
        %>
        <div class="section-title" style="margin-top:40px;">所有文字 / ALL POSTS</div>
        <div class="diary" style="margin-top:20px;">
          <% sorted.each(function(post){ %>
            <a class="diary-item" href="<%- url_for(post.path) %>">
              <div class="diary-date"><%= date(post.date, 'MM.DD') %></div>
              <div class="diary-body">
                <h3><%= post.title %></h3>
                <p><%= strip_html(post.excerpt || post.content).substring(0, 60) %>…</p>
              </div>
            </a>
          <% }) %>
          <% if (sorted.length === 0) { %>
            <p style="color:var(--mist-dim); font-size:13px;">還沒有寫下任何字。</p>
          <% } %>
        </div>
      <% } %>
    </div>

  <%- partial('partial/footer') %>
