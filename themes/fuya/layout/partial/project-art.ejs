<%
  // 企劃的小插圖。motif：calendar（日曆）、ring（花圈）、tarot（票券）、其他 = 一朵花。
  // 前三種用手繪插圖（themes/fuya/source/img/proj-*.webp），其他維持 SVG。呼叫時傳入 motif。
  var artImgs = {
    ring:     { src: 'proj-ring.webp',     w: 190, h: 176 },
    calendar: { src: 'proj-calendar.webp', w: 190, h: 183 },
    tarot:    { src: 'proj-tarot.webp',    w: 190, h: 165 }
  };
  var artImg = artImgs[motif];
%>
<% if (artImg) { %>
  <img class="tart" src="<%- url_for('/img/' + artImg.src) %>" width="<%= artImg.w %>" height="<%= artImg.h %>" loading="lazy" decoding="async" alt="" aria-hidden="true">
<% } else { %>
  <svg class="tart" width="190" height="170" viewBox="0 0 190 170" aria-hidden="true">
    <circle cx="95" cy="85" r="46" fill="#FFFCFA"/>
    <use href="#flw" x="65" y="55" width="60" height="60" style="color:#E8A5B3"/>
  </svg>
<% } %>
