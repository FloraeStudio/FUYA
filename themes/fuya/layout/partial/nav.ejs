<div class="topbar">
  <a class="brand" href="<%- url_for('/') %>">
    <span class="moon-ico"></span><%= config.title %>
  </a>
  <nav class="navlinks" aria-label="主選單">
    <% var current = (page.path || '').split('/')[0]; if (current === 'index.html') current = ''; %>
    <% theme.nav.forEach(function(item){
         var href = item.slug ? '/' + item.slug + '/' : '/';
         var active = item.slug === current || (item.slug === '' && !current);
    %>
      <a href="<%- url_for(href) %>" class="<%= active ? 'active' : '' %>"<%- active ? ' aria-current="page"' : '' %>><%= item.name %></a>
    <% }) %>
  </nav>
</div>