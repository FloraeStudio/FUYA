<% var sorted=page.posts.sort('-date'); %>
<% var series=theme.project_series || []; %>

  <% if (series.length) { %>
  <div class="section-title" style="margin-top:40px;">長期在寫的企劃 / SERIES</div>
  <div class="project-cards">
    <% series.forEach(function(s){ %>
      <div class="project-card pc-<%= s.color %>">
        <div class="pc-top">
          <span class="pc-dot"></span>
          <% if (s.badge) { %><span class="pc-badge"><%= s.badge %></span><% } %>
        </div>
        <h3><%= s.name %></h3>
        <% if (s.subtitle) { %><div class="pc-subtitle"><%= s.subtitle %></div><% } %>
        <% if (s.desc) { %><p><%= s.desc %></p><% } %>
        <% if (s.status) { %><div class="pc-status"><%= s.status %></div><% } %>
      </div>
    <% }) %>
  </div>
  <% } %>

  <div class="section-title" style="margin-top:56px;">所有企劃文字 / ENTRIES</div>
  <div class="diary" style="margin-top:20px;">
    <% sorted.each(function(post){ %>
      <a class="diary-item" href="<%- url_for(post.path) %>">
        <div class="diary-date">
          <%= date(post.date, 'MM.DD' ) %>
        </div>
        <div class="diary-body">
          <% if (post.is_series && post.status) { %>
            <span class="tag">
              <%= post.status %>
            </span>
            <% } %>
              <h3>
                <%= post.title %>
              </h3>
              <% if (post.description) { %>
                <p><%= post.description %></p>
              <% } else { %>
                <p><%= strip_html(post.excerpt || post.content).substring(0, 60) %>…</p>
              <% } %>
        </div>
      </a>
      <% }) %>
        <% if (sorted.length===0) { %>
          <p style="color:var(--mist-dim); font-size:13px;">故事，未完待續。</p>
          <% } %>
  </div>