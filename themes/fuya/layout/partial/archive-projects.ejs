<% var sorted=page.posts.sort('-date'); %>

  <div class="section-title" style="margin-top:40px;">進行中的企劃 / PROJECTS</div>
  <div class="diary" style="margin-top:20px;">
    <% sorted.each(function(post){ %>
      <a class="diary-item" href="<%- url_for(post.path) %>">
        <div class="diary-date">
          <%= date(post.date, 'MM.DD' ) %>
        </div>
        <div class="diary-body">
          <% if (post.is_series && post.status) { %>
            <span class="tag">
              <%= post.status %>
            </span>
            <% } %>
              <h3>
                <%= post.title %>
              </h3>
              <% if (post.description) { %>
                <p><%= post.description %></p>
              <% } else { %>
                <p><%= strip_html(post.excerpt || post.content).substring(0, 60) %>…</p>
              <% } %>
        </div>
      </a>
      <% }) %>
        <% if (sorted.length===0) { %>
          <p style="color:var(--mist-dim); font-size:13px;">故事，未完待續。</p>
          <% } %>
  </div>