<div class="section-title" style="margin-top:40px;">進行中的企劃 / PROJECTS</div>

<%
  // 每張卡片上方的小圖案由 _config.yml 裡各企劃的 motif 決定：
  //   ring = 十二顆星排成一圈　calendar = 掛式日曆　tarot = 三張疊開的牌　（沒填 = 一小串星座）
%>
<div class="project-grid">
  <% (theme.project_groups || []).forEach(function(group){
       var themeClass = group.theme === 'moon' ? 'pc-moon' : 'pc-lamp';
       var motif = group.motif || 'stars';
  %>
    <a class="project-card <%= themeClass %>" href="<%- url_for('/projects/' + group.key + '/') %>">
      <svg class="pcard-art" viewBox="0 0 200 90" aria-hidden="true">
        <% if (motif === 'ring') { %>
          <circle class="pa-line" cx="100" cy="45" r="32"/>
          <circle class="pa-faint" cx="100" cy="45" r="21" stroke-dasharray="2 4"/>
          <g class="pa-dots">
            <circle cx="100" cy="13" r="1.8"/><circle cx="127.7" cy="29" r="1.8"/><circle cx="132" cy="45" r="1.8"/>
            <circle cx="127.7" cy="61" r="1.8"/><circle cx="116" cy="72.7" r="1.8"/><circle cx="100" cy="77" r="1.8"/>
            <circle cx="84" cy="72.7" r="1.8"/><circle cx="72.3" cy="61" r="1.8"/><circle cx="68" cy="45" r="1.8"/>
            <circle cx="72.3" cy="29" r="1.8"/><circle cx="84" cy="17.3" r="1.8"/>
          </g>
          <circle class="pa-halo" cx="116" cy="17.3" r="7"/><circle class="pa-lit" cx="116" cy="17.3" r="3.2"/>
        <% } else if (motif === 'calendar') { %>
          <defs>
            <pattern id="pa-days" x="65.5" y="35" width="9.5" height="10" patternUnits="userSpaceOnUse">
              <circle cx="4.75" cy="5" r="1.1" fill="rgba(251,245,231,.35)"/>
            </pattern>
          </defs>
          <rect class="pa-paper" x="62" y="12" width="76" height="68" rx="3"/>
          <rect class="pa-head" x="62.5" y="12.5" width="75" height="16"/>
          <text class="pa-mono" x="100" y="24" text-anchor="middle" letter-spacing="2">OCT</text>
          <rect x="65.5" y="35" width="66.5" height="40" fill="url(#pa-days)"/>
          <circle class="pa-ring" cx="98.5" cy="50" r="5.5"/><circle class="pa-lit" cx="98.5" cy="50" r="1.6"/>
          <circle class="pa-halo" cx="117.5" cy="60" r="7"/><circle class="pa-lit" cx="117.5" cy="60" r="2.8"/>
          <circle class="pa-ring" cx="79.5" cy="70" r="5.5"/><circle class="pa-lit" cx="79.5" cy="70" r="1.6"/>
          <g class="pa-binding"><rect x="79" y="6" width="5" height="13" rx="2.5"/><rect x="116" y="6" width="5" height="13" rx="2.5"/></g>
        <% } else if (motif === 'tarot') { %>
          <rect class="pa-card-side" x="82" y="14" width="36" height="62" rx="4" transform="rotate(-16 100 80)"/>
          <rect class="pa-card-side" x="82" y="14" width="36" height="62" rx="4" transform="rotate(16 100 80)"/>
          <rect class="pa-card-main" x="82" y="12" width="36" height="62" rx="4"/>
          <rect class="pa-faint" x="87" y="17" width="26" height="52" rx="2"/>
          <path class="pa-fill" d="M105 34 A9 9 0 1 0 105 50 A7.6 7.6 0 0 1 105 34Z"/>
          <circle class="pa-fill" cx="94" cy="26" r="1.4"/><circle class="pa-fill" cx="108" cy="60" r="1.4"/><circle class="pa-fill" cx="93" cy="58" r="1"/>
        <% } else { %>
          <polyline class="pa-line" fill="none" points="60,56 100,18 140,56"/>
          <circle class="pa-lit" cx="60" cy="56" r="2.2"/><circle class="pa-lit" cx="100" cy="18" r="3"/><circle class="pa-lit" cx="140" cy="56" r="2.2"/>
        <% } %>
        <g class="pa-stray"><circle cx="34" cy="28" r="1"/><circle cx="30" cy="62" r="1"/><circle cx="168" cy="28" r="1"/><circle cx="172" cy="64" r="1"/></g>
      </svg>
      <h3><%= group.name %></h3>
      <% if (group.intro) { %><p><%= group.intro %></p><% } %>
      <span class="pcard-foot">
        <% if (group.badge) { %><span class="pc-badge"><%= group.badge %></span><% } else { %><span></span><% } %>
        <span class="pcard-go">進入 →</span>
      </span>
      <% if (group.status) { %><span class="pc-status"><%= group.status %></span><% } %>
    </a>
  <% }) %>
</div>
