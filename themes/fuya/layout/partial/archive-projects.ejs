<%
  // 企劃主題：每個企劃是一個主題，一張卡片。
  // 卡片上的小插圖由 _config.yml 裡各企劃的 motif 決定：calendar = 日曆　ring = 十二朵花圍成一圈　tarot = 疊開的牌　（沒填 = 一朵花）
  var navOf = function (k) { return (theme.nav || []).filter(function (n) { return n.key === k; })[0] || {}; };
  var navItem = navOf('proj');
  var groups = theme.project_groups || [];
  function countOf(key){
    return site.posts.filter(function(p){
      return p.project_group === key && p.categories && p.categories.some(function(c){ return c.name === '企劃'; });
    }).length;
  }
  var tints = { calendar: '#F8E6E4', ring: '#F4EBD9', tarot: '#E8E3F3', flower: '#F4EBD9' };
%>
<h1 class="page-title"><%= navItem.name || '主題企劃' %></h1>
<% if (navItem.desc) { %><p class="page-intro"><%= navItem.desc %></p><% } %>

<div class="theme-grid">
  <% groups.forEach(function(group){
       var motif = tints[group.motif] ? group.motif : 'flower';
       var live = group.badge && group.badge.indexOf('進行') !== -1;
  %>
    <a class="theme-card" href="<%- url_for('/projects/' + group.key + '/') %>">
      <div class="theme-art" style="background:<%= tints[motif] %>">
        <%- partial('partial/project-art', { motif: motif }) %>
            </div>
      <div class="theme-body">
        <div class="theme-name">
          <h2><%= group.name %></h2>
          <% if (group.badge) { %><span class="theme-badge<%= live ? ' live' : '' %>"><%= group.badge %></span><% } %>
        </div>
        <% if (group.intro) { %><p><%= group.intro %></p><% } %>
        <div class="theme-foot"><span><%= countOf(group.key) %> 篇</span><span class="go">進入主題</span></div>
      </div>
    </a>
  <% }) %>
</div>

<div class="theme-cta">
  <div>
    <h2>想要一篇有主題的故事？</h2>
    <p>委託時可以直接選這些主題當靈感，也可以在表單裡寫「tag：主題名」。</p>
  </div>
  <a class="theme-link" href="<%- url_for('/commission/') %>">查看委託項目</a>
</div>
