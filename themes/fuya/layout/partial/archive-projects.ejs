<div class="section-title" style="margin-top:40px;">進行中的企劃 / PROJECTS</div>

<div class="project-constellation">
  <div class="pc-row" aria-hidden="true">
    <% (theme.project_groups || []).forEach(function(group, i){ %>
      <% if (i > 0) { %><span class="pc-node-line"></span><% } %>
      <span class="pc-node-dot <%= group.theme === 'moon' ? 'pc-moon' : 'pc-lamp' %>"></span>
    <% }) %>
  </div>

  <div class="pc-labels">
    <% (theme.project_groups || []).forEach(function(group){
         var themeClass = group.theme === 'moon' ? 'pc-moon' : 'pc-lamp';
    %>
      <a class="pc-label <%= themeClass %>" href="<%- url_for('/projects/' + group.key + '/') %>">
        <% if (group.badge) { %><span class="pc-badge"><%= group.badge %></span><% } %>
        <h3><%= group.name %></h3>
        <% if (group.intro) { %><p><%= group.intro %></p><% } %>
        <% if (group.status) { %><span class="pc-status"><%= group.status %></span><% } %>
      </a>
    <% }) %>
  </div>
</div>