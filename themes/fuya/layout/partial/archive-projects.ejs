<div class="section-title" style="margin-top:40px;">進行中的企劃 / PROJECTS</div>

<div class="project-list">
  <% var groups = theme.project_groups || []; %>
  <% groups.forEach(function(group, i){
       var themeClass = group.theme === 'moon' ? 'pc-moon' : 'pc-lamp';
       var isLast = i === groups.length - 1;
  %>
    <a class="project-item <%= themeClass %><%= isLast ? ' is-last' : '' %>" href="<%- url_for('/projects/' + group.key + '/') %>">
      <span class="pi-rail" aria-hidden="true">
        <span class="pi-dot"></span>
        <% if (!isLast) { %><span class="pi-line"></span><% } %>
      </span>
      <span class="pi-body">
        <span class="pi-head">
          <% if (group.badge) { %><span class="pc-badge"><%= group.badge %></span><% } %>
          <h3><%= group.name %></h3>
        </span>
        <% if (group.intro) { %><p><%= group.intro %></p><% } %>
        <% if (group.status) { %><span class="pc-status"><%= group.status %></span><% } %>
      </span>
    </a>
  <% }) %>
</div>
