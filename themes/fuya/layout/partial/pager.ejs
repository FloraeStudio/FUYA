<%
  // 用法：partial 呼叫時傳入 pager（分頁物件）跟 light（'moon' 或 'lamp'）兩個參數
  // pager: Hexo 分頁物件（category_generator per_page > 0 時，page 本身就帶有 total/current/prev/next/base）
  // light: 'moon' 給轉蛋頁用；不傳或傳其他值一律當作 'lamp'（企劃、委託、雜談共用）
  var pager = locals.pager;
  var lightClass = (locals.light === 'moon') ? 'pc-moon' : 'pc-lamp';
%>
<% if (pager && pager.total > 1) { %>
  <%
    var total = pager.total;
    var current = pager.current;
    var pdir = config.pagination_dir || 'page';

    function pageUrl(i) {
      return i === 1 ? pager.base : pager.base + pdir + '/' + i + '/';
    }
  %>
  <nav class="site-pager <%= lightClass %>" aria-label="分頁">
    <% if (pager.prev) { %>
      <a class="sp-link" href="<%- url_for(pageUrl(pager.prev)) %>">‹ 上一頁</a>
    <% } else { %>
      <span class="sp-link is-disabled">‹ 上一頁</span>
    <% } %>

    <span class="sp-status">第 <%= current %> / <%= total %> 頁</span>

    <% if (pager.next) { %>
      <a class="sp-link" href="<%- url_for(pageUrl(pager.next)) %>">下一頁 ›</a>
    <% } else { %>
      <span class="sp-link is-disabled">下一頁 ›</span>
    <% } %>
  </nav>
<% } %>
