<%
  // 置頂文章一律排在最前面（彼此之間仍依日期新到舊），其餘文章維持原本的日期排序。
  var sorted = page.posts.sort('-date').toArray().sort(function(a, b){
    return (b.pin ? 1 : 0) - (a.pin ? 1 : 0);
  });

  var cm = site.data.commission || {};
  var status = cm.accepting_status || '工作室修整中';
  var plans = theme.commission_plans || [];
  var flow = theme.commission_flow || [];
  var faq = theme.commission_faq || [];

  // 名額：slots_open 是「還能接幾個」，亮燈數 = 剩餘名額
  var slotsTotal = parseInt(cm.slots_total, 10) || 0;
  var slotsOpen = Math.max(0, Math.min(slotsTotal, parseInt(cm.slots_open, 10) || 0));
  var waitText = cm.wait_estimate || '';
  var isOpen = status === '開放中';

  // 日期統一轉成 YYYY-MM-DD 字串（YAML 可能把它讀成 Date）
  function d10(v){
    if (!v) return '';
    return (v instanceof Date ? v.toISOString() : String(v)).slice(0, 10);
  }

  // 只輸出「可公開」的欄位；public: false 的整筆不會進到網頁原始碼。
  // 交稿排程：一筆一個日期（預計交稿日）。已完成的也帶出去，由前端只保留最近 14 天。
  var deliveries = (cm.schedule || [])
    .filter(function(e){ return e && e.public !== false && d10(e.deliver_on || e.end); })
    .map(function(e){
     return {
       id: e.id || '', type: e.type || '', date: d10(e.deliver_on || e.end), done: !!e.done,
       // showcase：private（預設，不公開）／public（公開）／masked（姓名打碼後公開）；post：對應文章的標題
       showcase: e.showcase || 'private', post: e.post || ''
     };
    })
    .sort(function(a, b){ return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; });
  var marks = (cm.marks || [])
    .filter(function(m){ return m && d10(m.date); })
    .map(function(m){ return { date: d10(m.date), text: m.text || '', rest: !!m.rest }; });
  var types = plans.map(function(p){ return { key: p.key, name: p.name }; });
  // 牌單（commission_plans）沒有列出、但後台排程可以選的類型，月曆也要認得名稱
  var extraTypes = { egg: '轉蛋' };
  Object.keys(extraTypes).forEach(function(k){
    if (!types.some(function(t){ return t.key === k; })) types.push({ key: k, name: extraTypes[k] });
  });
  // 已完成的委託點開後，可以連到作品展示裡對應的文章：這裡把可連結的作品（標題、網址、開頭預覽）一起帶進頁面。
  var workCats = ['轉蛋', '企劃', '委託'];
  var works = site.posts.filter(function(p){
    return (p.categories || []).some(function(c){ return workCats.indexOf(c.name) !== -1; });
  }).map(function(p){
    var t = strip_html(p.excerpt || p.content || '').replace(/\s+/g, ' ').trim();
    return { title: p.title, path: url_for(p.path), text: t.slice(0, 90) };
  });
  var payload = JSON.stringify({ deliveries: deliveries, marks: marks, types: types, works: works, worksUrl: url_for('/works/') }).replace(/</g, '\\u003c');
%>
<link rel="stylesheet" href="<%- url_for('/css/commission.css') %>">

<section class="cm-hero">
  <h1 class="page-title">委託菜單</h1>
  <% if (theme.commission_intro) { %><p class="page-lede"><%= theme.commission_intro %></p><% } %>
</section>

<%- partial('partial/commission-status') %>

<% if (plans.length) { %>
  <section class="cm-sec cm-two">
    <div class="cm-side">
      <h2>方案</h2>
      <p class="cm-hint" id="cm-hint" hidden>點一個方案，下面的交稿排程會標出同一類的委託。再點一次取消。</p>
    </div>
    <div class="cm-menu" id="cm-menu">
      <% plans.forEach(function(p){ %>
        <button type="button" class="cm-it" data-t="<%= p.key %>" aria-pressed="false">
          <span class="cm-top">
            <svg class="cm-fl" width="24" height="24" aria-hidden="true"><use href="#flw"/></svg>
            <span class="cm-nm"><%= p.name %></span>
            <span class="cm-ld"></span>
            <span class="cm-pr"><%= String(p.price).replace('/', ' / ') %></span>
          </span>
          <span class="cm-ds">
            <% if (p.range && String(p.range).trim() !== '-') { %><span class="cm-rg"><%= p.range %></span><% } %>
            <%= p.note %>
          </span>
        </button>
      <% }) %>
    </div>
  </section>
<% } %>

<section class="cm-sec">
  <div class="cm-cal" id="cm" data-api="<%= cm.api_url || '' %>">
    <div class="cm-head-row">
      <h2>交稿排程</h2>
      <div class="cm-mh">
        <button type="button" class="cm-nav" id="cm-prev" aria-label="上個月">‹</button>
        <span class="cm-title" id="cm-title"></span>
        <button type="button" class="cm-nav" id="cm-next" aria-label="下個月">›</button>
      </div>
    </div>
    <div class="cm-scroll">
      <div class="cm-wd" aria-hidden="true"><div>日</div><div>一</div><div>二</div><div>三</div><div>四</div><div>五</div><div>六</div></div>
      <div class="cm-grid" id="cm-grid"></div>
    </div>
    <div class="cm-list" id="cm-list"></div>
    <p class="cm-foot" id="cm-foot">花朵標在預計交稿日，只顯示單號或代稱。已完成的標記可以點開看看。</p>
  </div>
</section>
<script type="application/json" id="cm-data"><%- payload %></script>
<script src="<%- url_for('/js/commission-calendar.js') %>" defer></script>

<% if (flow.length) { %>
  <section class="cm-sec">
    <h2>委託流程</h2>
    <ol class="cm-steps">
      <% flow.forEach(function(step, i){ %>
        <li class="cm-step"><span class="num"><%= i + 1 %></span><p><%= step %></p></li>
      <% }) %>
    </ol>
  </section>
<% } %>

<% if (faq.length) { %>
  <section class="cm-sec cm-two">
    <div class="cm-side">
      <h2>下單前先看</h2>
      <p>委託默認已閱讀完畢並且同意委託須知。</p>
    </div>
    <div class="cm-faq">
      <% faq.forEach(function(item){ %>
        <details>
          <summary><span class="q"><%= item.q %></span><svg class="plus" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 2 V16 M2 9 H16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg></summary>
          <p class="ans"><%= item.a %></p>
        </details>
      <% }) %>
    </div>
  </section>
<% } %>

<% var contact = theme.commission_contact || {}; if (contact.url) { %>
  <section class="cm-sec">
    <div class="cm-cta">
      <div>
        <h2><%= contact.title || '想委託的話' %></h2>
        <% if (contact.text) { %><p><%= contact.text %></p><% } %>
      </div>
      <a class="cta-btn" href="<%= contact.url %>" target="_blank" rel="noopener"><%= contact.label || '來信預約' %></a>
    </div>
  </section>
<% } %>

<section class="cm-sec cm-two">
  <div class="cm-side">
    <h2>作品</h2>
    <p>委託完成後，經同意公開的作品。</p>
  </div>
  <div class="diary">
    <% sorted.forEach(function(post){ %>
      <a class="diary-item" href="<%- url_for(post.path) %>">
        <div class="diary-date"><%= date(post.date, 'MM.DD' ) %></div>
        <div class="diary-body">
          <% if (post.pin) { %><span class="pin-badge"><span class="dot"></span>置頂</span><% } %>
          <h3><%= post.title %></h3>
          <% if (post.description) { %>
            <p><%= post.description %></p>
          <% } else { %>
            <p><%- strip_html(post.excerpt || post.content).substring(0, 60) %>…</p>
          <% } %>
        </div>
      </a>
    <% }) %>
    <% if (sorted.length===0) { %><p class="empty-note">故事，未完待續。</p><% } %>
  </div>
</section>

<%- partial('partial/pager', { pager: page, light: 'lamp' }) %>
