<%
  // 置頂文章一律排在最前面（彼此之間仍依日期新到舊），其餘文章維持原本的日期排序。
  var sorted = page.posts.sort('-date').toArray().sort(function(a, b){
    return (b.pin ? 1 : 0) - (a.pin ? 1 : 0);
  });
  var status=(site.data.commission && site.data.commission.accepting_status) || '工作室修整中' ; var plans=theme.commission_plans
  || []; var flow=theme.commission_flow || []; var faq=theme.commission_faq || []; %>

  <div class="commission-status" style="margin-top:56px;">
    <span class="dot"></span>
    目前狀態：<%= status %>
  </div>

  <div class="section-title" style="margin-top:20px;">作品 / WORKS</div>
  <div class="diary" style="margin-top:20px;">
    <% sorted.forEach(function(post){ %>
      <a class="diary-item" href="<%- url_for(post.path) %>">
        <div class="diary-date">
          <%= date(post.date, 'MM.DD' ) %>
        </div>
        <div class="diary-body">
          <% if (post.pin) { %><span class="pin-badge"><span class="dot"></span>置頂</span><% } %>
          <h3>
            <%= post.title %>
          </h3>
          <% if (post.description) { %>
            <p>
              <%= post.description %>
            </p>
            <% } else { %>
              <p><%- strip_html(post.excerpt || post.content).substring(0, 60) %>…</p>
              <% } %>
        </div>
      </a>
      <% }) %>
        <% if (sorted.length===0) { %>
          <p style="color:var(--mist-dim); font-size:13px;">故事，未完待續。</p>
          <% } %>
  </div>

  <%- partial('partial/pager', { pager: page, light: 'lamp' }) %>

    <% if (plans.length) { %>
      <div class="section-title" style="margin-top:56px;">方案 / PLANS</div>
      <div class="plan-track">
        <% plans.forEach(function(p){ %>
          <div class="plan-point" data-tier="<%= p.key %>">
            <span class="dot"></span>
            <h4>
              <%= p.name %>
            </h4>
            <div class="plan-range">
              <%= p.range %>
            </div>
            <div class="plan-price">
              <%= p.price %>
            </div>
            <div class="plan-note">
              <%= p.note %>
            </div>
          </div>
          <% }) %>
      </div>
      <% } %>

        <% if (flow.length) { %>
          <div class="section-title" style="margin-top:60px;">流程 / HOW IT WORKS</div>
          <div style="margin-top:20px;">
            <% flow.forEach(function(step, i){ %>
              <div class="flow-item">
                <div class="flow-index">
                  <%= ('0' + (i + 1)).slice(-2) %>
                </div>
                <p>
                  <%= step %>
                </p>
              </div>
              <% }) %>
          </div>
          <% } %>

            <% if (faq.length) { %>
              <div class="section-title" style="margin-top:60px;">常見問題 / FAQ</div>
              <div style="margin-top:20px;">
                <% faq.forEach(function(item){ %>
                  <div class="faq-item">
                    <h4>
                      <%= item.q %>
                    </h4>
                    <p>
                      <%= item.a %>
                    </p>
                  </div>
                  <% }) %>
              </div>
              <% } %>