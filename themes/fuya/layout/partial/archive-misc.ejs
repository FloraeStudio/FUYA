<%
  var sorted = page.posts.sort('-date');
  var groups = [];
  var lastKey = null;
  sorted.each(function(post){
    var key = date(post.date, 'YYYY.MM');
    if (key !== lastKey) {
      groups.push({ key: key, posts: [] });
      lastKey = key;
    }
    groups[groups.length - 1].posts.push(post);
  });
%>

<div style="margin-top:40px;">
  <% if (groups.length === 0) { %>
    <p style="color:var(--mist-dim); font-size:13px;">故事，未完待續。</p>
  <% } %>
  <% groups.forEach(function(g){ %>
    <div class="misc-month-label"><%= g.key %></div>
    <% g.posts.forEach(function(post){ %>
      <a class="misc-item" href="<%- url_for(post.path) %>">
        <div class="misc-date"><%= date(post.date, 'MM.DD') %></div>
        <div>
          <h3><%= post.title %></h3>
          <% if (post.description) { %>
            <p><%= post.description %></p>
          <% } else { %>
            <p><%= strip_html(post.excerpt || post.content).substring(0, 60) %>…</p>
          <% } %>
        </div>
      </a>
    <% }) %>
  <% }) %>
</div>
