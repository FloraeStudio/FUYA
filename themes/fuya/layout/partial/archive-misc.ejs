<%
  // 置頂文章排在最前面（仍依各自日期顯示所屬月份），其餘文章維持原本依月份分組的日期排序。
  var sorted = page.posts.sort('-date').toArray().sort(function(a, b){
    return (b.pin ? 1 : 0) - (a.pin ? 1 : 0);
  });
  var groups=[]; var lastKey=null; sorted.forEach(function(post){ var
  key=date(post.date, 'YYYY.MM' ); if (key !==lastKey) { groups.push({ key: key, posts: [] }); lastKey=key; }
  groups[groups.length - 1].posts.push(post); }); %>

  <div style="margin-top:40px;">
    <% if (groups.length===0) { %>
      <p style="color:var(--mist-dim); font-size:13px;">故事，未完待續。</p>
      <% } %>
        <% groups.forEach(function(g){ %>
          <div class="misc-month-label">
            <%= g.key %>
          </div>
          <% g.posts.forEach(function(post){ %>
            <a class="misc-item" href="<%- url_for(post.path) %>">
              <div class="misc-date">
                <%= date(post.date, 'MM.DD' ) %>
              </div>
              <div>
                <% if (post.pin) { %><span class="pin-badge"><span class="dot"></span>置頂</span><% } %>
                <h3>
                  <%= post.title %>
                </h3>
                <% if (post.description) { %>
                  <p>
                    <%= post.description %>
                  </p>
                  <% } else { %>
                    <p><%- strip_html(post.excerpt || post.content).substring(0, 60) %>…</p>
                    <% } %>
              </div>
            </a>
            <% }) %>
              <% }) %>
  </div>

  <%- partial('partial/pager', { pager: page, light: 'lamp' }) %>