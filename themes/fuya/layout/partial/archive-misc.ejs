<%
  // 置頂文章排在最前面（仍依各自日期顯示所屬月份），其餘文章維持原本依月份分組的日期排序。
  var sorted = page.posts.sort('-date').toArray().sort(function(a, b){
    return (b.pin ? 1 : 0) - (a.pin ? 1 : 0);
  });
  var groups = [];
  var lastKey = null;
  sorted.forEach(function(post){
    var key = date(post.date, 'YYYY.MM');
    if (key !== lastKey) { groups.push({ key: key, posts: [] }); lastKey = key; }
    groups[groups.length - 1].posts.push(post);
  });
  // 標題與說明跟導覽用同一份設定（_config.yml 的 nav），改一處就好。
  var navItem = (theme.nav || []).filter(function(n){ return n.key === 'misc'; })[0] || {};
  function previewOf(p){
    if (p.description) return p.description;
    var t = strip_html(p.excerpt || p.content || '').replace(/\s+/g, ' ').trim();
    return t.length > 150 ? t.slice(0, 150) : t;
  }
  // 總篇數：分類頁沒有 page.total_posts，直接數「雜談」分類。
  var miscCat = site.categories.findOne({ name: '雜談' });
  var totalPosts = miscCat ? miscCat.length : page.posts.length;
%>
<h1 class="page-title"><%= navItem.name || '店長手札' %></h1>
<% if (navItem.desc) { %><p class="page-intro"><%= navItem.desc %></p><% } %>

<div class="misc-wrap">
  <% if (groups.length === 0) { %>
    <p class="empty-note">手札暫時留白，等下一個值得記錄的日常。</p>
  <% } %>
  <% groups.forEach(function(g){ %>
    <section class="misc-month">
      <h2 class="misc-month-label"><svg width="16" height="16" aria-hidden="true"><use href="#flw"/></svg><span><%= g.key %></span></h2>
      <div class="works-list">
        <% g.posts.forEach(function(post){ var pv = previewOf(post); %>
          <a class="work-row" href="<%- url_for(post.path) %>">
            <span class="work-meta">
              <span class="work-date"><%= date(post.date, 'YYYY.MM.DD') %></span>
            </span>
            <span class="work-main">
              <span class="work-head">
                <% if (post.pin) { %><span class="pin-badge"><span class="dot"></span>置頂</span><% } %>
                <span class="work-title"><%= post.title %></span>
              </span>
              <% if (pv) { %><span class="work-preview"><%= pv %></span><% } %>
            </span>
          </a>
        <% }) %>
      </div>
    </section>
  <% }) %>
</div>

<div class="works-foot">
  <span class="works-count">共 <%= totalPosts %> 篇<% if (page.total > 1) { %>，第 <%= page.current %> / <%= page.total %> 頁<% } %></span>
  <%- partial('partial/pager', { pager: page, light: 'lamp' }) %>
</div>
