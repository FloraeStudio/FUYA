<%
  // 首頁品牌文字。內容寫在 source/_data/site.yml（後台「首頁設定」也能改）；
  // 欄位留空時退回下面的預設文字，頁面不會空掉。
  var siteData = site.data.site || {};
  var pick = function (v, d) { return (v && String(v).trim()) ? String(v) : d; };
  var lines = function (v) { return String(v).split(/\r?\n/).map(function (t) { return t.trim(); }).filter(Boolean); };

  var eyebrow = pick(siteData.hero_eyebrow, 'WELCOME TO MY LITTLE STORY SHOP');
  var tagLines = lines(pick(siteData.hero_tagline, 'A little story,\na little sweetness.'));
  var tagZh = pick(siteData.hero_tagline_zh, '一些故事，一點甜，一份值得被記住的日常。');
  var poem = lines(pick(siteData.hero_text, '收集那些不經意的心動、沒有說出口的話，\n以及每一段值得被記住的相遇。'));
  var heroSign = pick(siteData.hero_sign, '✿ A LITTLE PLACE FOR EVERY LITTLE STORY. ✿');

  // 標語最後一行的最後一個英文字加上粉色手繪底線
  var lastIdx = tagLines.length - 1;
  var tagHtml = tagLines.map(function (t, i) {
    var safe = escape_html(t);
    if (i === lastIdx) {
      safe = safe.replace(/([A-Za-zÀ-ɏ]+)([.!?。！？]*)$/, '<span class="hl">$1<svg class="hl-wave" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M3 7 Q15 1 27 7 T51 7 T75 7 T99 7 T123 7 T147 7 T171 7 T197 7" pathLength="1"/></svg></span>$2');
    }
    return '<span class="tag-line">' + safe + '</span>';
  }).join('');

  var flower = '<svg class="fl" width="16" height="16" aria-hidden="true" focusable="false"><use href="#flw"/></svg>';
  var signHtml = escape_html(heroSign).replace(/✿/g, flower);
%>
<section class="hero">
  <div class="hero-text">
    <h1 class="hero-tagline hl-in" style="--i:0"><%- tagHtml %></h1>
    <p class="hero-tagline-zh hl-in" style="--i:2"><%= tagZh %></p>

    <p class="hero-label hl-in" style="--i:3"><%= eyebrow %></p>
    <p class="hero-poem">
      <% poem.forEach(function (t, i) { %><span class="hl-in" style="--i:<%= 4 + i %>"><%= t %></span><% }) %>
    </p>
    <p class="hero-sign hl-in" style="--i:<%= 4 + poem.length %>"><%- signHtml %></p>

    <div class="hero-actions hl-in" style="--i:<%= 5 + poem.length %>">
      <a class="btn-main" href="<%- url_for('/commission/') %>">看委託菜單</a>
      <a class="btn-text" href="<%- url_for('/gacha/') %>">讀幾篇作品</a>
    </div>
    <% if (siteData.status_line) { %>
      <p class="hero-status hl-in" style="--i:<%= 6 + poem.length %>">近況：<%= siteData.status_line %></p>
    <% } %>
  </div>

  <div class="hero-art">
    <div class="stage">
      <img class="shopfront-img" src="<%- url_for('/img/hero-shopfront.webp') %>" width="1100" height="963" fetchpriority="high" decoding="async" alt="粉色條紋遮陽棚的小店櫥窗，裡面有草莓蛋糕、馬卡龍、花束、書本和一封信，窗邊飛著一隻蝴蝶">
      <span class="stage-glow" aria-hidden="true"></span>
    </div>
  </div>
</section>
