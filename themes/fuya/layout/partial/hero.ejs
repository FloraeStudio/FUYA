    <circle class="hs-moon-halo" cx="268" cy="88" r="24"/>
    <path class="hs-moon" d="M275 76A13 13 0 1 0 275 100A12 12 0 0 1 275 76Z"/>
    <g class="hs-star-moon">
      <path d="M202 74Q202 80 208 80Q202 80 202 86Q202 80 196 80Q202 80 202 75Z"/>
      <path d="M214 156Q214 160 218 160Q214 160 214 164Q214 160 210 160Q214 160 214 157Z"/>
      <circle cx="195" cy="118" r="1.2"/><circle cx="288" cy="152" r="1.2"/>
    </g>

    <rect class="hs-sill" x="155" y="220" width="170" height="8" rx="1"/>
    <line class="hs-sill-under" x1="148" y1="234" x2="332" y2="234"/>
    <polygon fill="url(#hs-beam)" points="266,200 294,200 306,220 254,220"/>
    <ellipse class="hs-lamp-base" cx="280" cy="219" rx="9" ry="2.5"/>
    <line class="hs-lamp-stem" x1="280" y1="218" x2="280" y2="200"/>
