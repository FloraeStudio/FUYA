  <div class="window">
    <div class="moon-body"></div>
    <span class="mini-star" style="top:18%; left:22%; animation-delay:.3s;"></span>
    <span class="mini-star" style="top:28%; left:78%; animation-delay:1.1s;"></span>
    <span class="mini-star" style="top:75%; left:20%; animation-delay:1.8s;"></span>
    <span class="mini-star" style="top:80%; left:70%; animation-delay:.7s;"></span>
