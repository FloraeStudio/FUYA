    <g class="hs-steam"><path d="M203 199C199 192 207 188 203 182C200 178 205 176 204 174"/><path d="M211 198C207 191 215 187 211 181C208 177 213 175 212 173"/></g>
    <line class="hs-ground" x1="110" y1="244" x2="370" y2="244"/>

    <g class="hs-twinkle">
        <path class="hs-star-lamp" d="M372 55Q372 64 381 64Q372 64 372 73Q372 64 363 64Q372 64 372 55Z"/>
        <path class="hs-star-lamp" style="animation-delay:1.1s" d="M412 93Q412 98 417 98Q412 98 412 103Q412 98 407 98Q412 98 412 93Z"/>
        <path class="hs-star-lamp" style="animation-delay:2.2s" d="M388 138Q388 142 392 142Q388 142 388 146Q388 142 384 142Q388 142 388 138Z"/>
        <path class="hs-star-lamp" style="animation-delay:0.6s" d="M336 42Q336 46 340 46Q336 46 336 50Q336 46 332 46Q336 46 336 42Z"/>
        <path class="hs-star-lamp" style="animation-delay:1.7s" d="M436 55Q436 58 439 58Q436 58 436 61Q436 58 433 58Q436 58 436 55Z"/>
        <path class="hs-star-moon" style="animation-delay:0.4s" d="M142 73Q142 80 149 80Q142 80 142 87Q142 80 135 80Q142 80 142 73Z"/>
        <path class="hs-star-moon" style="animation-delay:1.5s" d="M106 121.5Q106 126 110.5 126Q106 126 106 130.5Q106 126 101.5 126Q106 126 106 121.5Z"/>
