        <stop offset="0" stop-color="#A9ABC6" stop-opacity=".55"/><stop offset="1" stop-color="#A9ABC6" stop-opacity="0"/>
      </linearGradient>
    </defs>

    <ellipse cx="240" cy="234" rx="110" ry="24" fill="url(#hs-spill)"/>
