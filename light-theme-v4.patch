+
+.shop .post-content {
+  margin-top: 44px;
+  font-family: var(--font-serif);
+  font-size: 17px;
+  line-height: 2.15;
+  letter-spacing: .02em;
+}
+
+.shop .post-end {
+  display: flex;
+  justify-content: center;
+  gap: 14px;
+  margin-top: 48px;
+  color: #E8A5B3;
+}
