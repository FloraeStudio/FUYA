+
+.works-foot {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px 24px;
+  margin-top: 32px;
+}
+
+.works-count {
+  font-size: 15px;
+  color: var(--text-dim);
