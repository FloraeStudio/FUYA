+.shop .post-end svg:nth-child(2) { color: #CDBFEA; }
+.shop .post-end svg:nth-child(3) { color: #F8D983; }
+
+.shop .post-links {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 4px 18px;
+  margin: 36px 0 0;
+  font-size: 13px;
+  color: var(--text-dim);
+}
+
+.shop .post-links a {
+  padding: 8px 0;
+  border: 0;
+  border-bottom: 1px solid var(--line-strong);
+  font-size: 13px;
+  color: var(--text-soft);
+}
+
+.shop .post-adj {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
+  gap: 14px;
+  margin-top: 40px;
+}
+
+.shop .post-adj .adj {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  min-height: 44px;
+  padding: 20px 22px;
+  border: 1px solid #EADDD6;
+  border-radius: 18px;
+  background: var(--surface);
+  color: var(--text);
+}
+
+.shop .post-adj .adj.next {
+  text-align: right;
+}
+
+.shop .adj-l {
+  font-size: 14px;
+  color: var(--text-dim);
+}
+
+.shop .adj-t {
+  font-family: var(--font-serif);
+  font-weight: 600;
+  font-size: 17px;
+  line-height: 1.5;
+}
+
+.shop .post-cta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 18px 32px;
+  margin-top: 40px;
+  padding: 30px 32px;
+  border: 1px solid #EADDD6;
+  border-radius: 22px;
+  background: var(--surface);
+}
+
+.shop .post-cta > div {
+  flex: 1 1 280px;
+}
+
+.shop .post-cta h2 {
+  margin: 0;
+  font-family: var(--font-serif);
+  font-weight: 600;
+  font-size: 19px;
+  letter-spacing: .04em;
+  color: var(--text);
+}
+
+.shop .post-cta p {
+  margin: 8px 0 0;
+  font-size: 15px;
+  line-height: 1.9;
+  color: var(--text-soft);
+}
+
+.shop .post-cta .cta-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 48px;
+  padding: 0 28px;
+  border-radius: 999px;
+  background: var(--green);
+  color: #FFFCFA;
+  font-size: 16px;
+}
+
+.shop .post-detail > .back-link:last-child {
+  margin-top: 32px;
+}
+
+/* 分頁：圓形頁碼 */
+.shop .works-foot .sp-page,
+.shop .works-foot .sp-link {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 44px;
+  min-height: 44px;
+}
+
+.shop .works-foot .sp-page.is-current {
+  min-width: 44px;
+  height: 44px;
+  border-radius: 50%;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .work-row:hover { background: var(--surface); }
+  .work-row:hover .work-title { color: var(--accent); }
+  .work-row:hover .work-src svg { transform: rotate(72deg) scale(1.15); }
+  .shop .post-adj .adj:hover { border-color: #D9B9B3; background: #fff; }
+  .shop .post-adj .adj:hover .adj-t { color: var(--accent); }
+  .shop .post-links a:hover { background: none; color: var(--accent); border-bottom-color: var(--accent); }
+  .shop .post-cta .cta-btn:hover { background: var(--green-deep); }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .work-row { transition: background .25s; }
+  .work-title { transition: color .2s; }
+  .work-src svg { transition: transform .45s cubic-bezier(.3, 1.5, .5, 1); }
+  .shop .post-adj .adj { transition: background .25s, border-color .25s, transform .25s; }
+  .shop .post-adj .adj:hover { transform: translateY(-3px); }
+}
+
+@media (max-width: 620px) {
+  .work-row { grid-template-columns: minmax(0, 1fr); padding: 22px 0; }
+  .work-meta { flex-direction: row; align-items: center; gap: 14px; padding-top: 0; }
+  .shop .archive-page.works-page { padding-top: 40px; }
+  .shop .post-detail { padding-top: 32px; }
+  .shop .post-content { font-size: 16.5px; }
+  .shop .post-cta { padding: 24px; }
+}
