+  font-size: 13px;
+  color: var(--text-soft);
+}
+
+.shop .post-title {
+  margin: 14px 0 0;
+  font-family: var(--font-serif);
+  font-weight: 400;
+  font-size: clamp(26px, 3.2vw, 34px);
+  letter-spacing: .05em;
+  line-height: 1.5;
+  color: var(--text);
+}
+
+.shop .post-tags {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin: 20px 0 0;
+  padding-bottom: 44px;
+  border-bottom: 1px solid var(--line);
