+}
+
+.work-date {
+  font-family: var(--font-serif);
+  font-size: 15px;
+  color: var(--text);
+}
+
+.work-src {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--c);
+}
+
+.work-src svg {
