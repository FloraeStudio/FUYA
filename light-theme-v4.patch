+   ================================================ */
+.shop .c-egg  { --c: var(--t-egg);    --cb: var(--t-egg-bg); }
+.shop .c-proj { --c: var(--accent);   --cb: var(--t-medium-bg); }
+.shop .c-comm { --c: #936313;         --cb: var(--t-long-bg); }
