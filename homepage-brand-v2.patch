new file mode 100644
index 0000000..3cb26a9
--- /dev/null
+++ b/themes/fuya/layout/partial/intro.ejs
@@ -0,0 +1,25 @@
+<%
+  // 首頁的小小自我介紹。內容寫在 source/_data/site.yml（後台「首頁設定」也能改）。
+  var siteData = site.data.site || {};
+  var pickI = function (v, d) { return (v && String(v).trim()) ? String(v) : d; };
+  var linesI = function (v) { return String(v).split(/\r?\n/).map(function (t) { return t.trim(); }).filter(Boolean); };
+
+  var introTitle = pickI(siteData.intro_title, '你好，歡迎來到我的小小故事收藏室。');
+  var introLines = linesI(pickI(siteData.intro_text, '我總覺得，這個世界上有好多好多故事。\n它們藏在某一次擦肩而過的眼神裡、藏在午後沒有喝完的咖啡裡，也藏在那些明明很平凡，卻讓人忍不住記住的瞬間。\n於是，我開始寫字。\n把遇見的人、想像的世界、說不出口的情緒，以及那些稍縱即逝的心動，一點一點地寫下來。\n如果你也喜歡故事，歡迎在這裡坐坐。'));
+  var introClosing = pickI(siteData.intro_closing, '今天想為你留一份什麼樣的故事呢？');
+%>
+<section class="home-sec home-intro">
+  <div class="home-side rv">
+    <svg class="intro-fl fl" width="26" height="26" aria-hidden="true" focusable="false"><use href="#flw"/></svg>
+    <h2><%= introTitle %></h2>
+  </div>
+  <div class="home-main intro-body">
+    <% introLines.forEach(function (t, i) { %>
+      <p class="rv" style="--d:<%= i %>"><%= t %></p>
+    <% }) %>
+    <p class="intro-closing rv" style="--d:<%= introLines.length %>">
+      <svg class="fl" width="22" height="22" aria-hidden="true" focusable="false"><use href="#flw"/></svg>
+      <span><%= introClosing %></span>
+    </p>
+  </div>
+</section>
diff --git a/themes/fuya/source/css/home.css b/themes/fuya/source/css/home.css
new file mode 100644
index 0000000..0b30715
--- /dev/null
+++ b/themes/fuya/source/css/home.css
@@ -0,0 +1,338 @@
+/* ------------------------------------------------
+   home — 首頁品牌文字版面與動畫
+   品牌核心：A little story, a little sweetness.
+   載入順序在 shop.css 之後。動畫全部包在 prefers-reduced-motion: no-preference 裡，
+   系統開了「減少動態效果」的人會直接看到完整靜態版。
+------------------------------------------------ */
+
+/* ---------- 主視覺文字 ---------- */
+.shop .hero {
+  position: relative;
+}
+
+.hero-text {
+  position: relative;
+  z-index: 1;
+}
+
+.shop .hero-text .hero-tagline {
+  margin: 0;
+  font-family: var(--font-latin);
+  font-style: italic;
+  font-weight: 500;
+  font-size: clamp(40px, 5.6vw, 74px);
+  line-height: 1.04;
+  letter-spacing: -.005em;
+  color: var(--text);
+}
+
+.tag-line {
+  display: block;
+}
+
+.hl {
+  position: relative;
+  display: inline-block;
+  color: var(--accent);
+}
+
+.hl-wave {
+  position: absolute;
+  left: 0;
+  bottom: -.12em;
+  width: 100%;
+  height: .2em;
+  overflow: visible;
+}
+
+.hl-wave path {
+  fill: none;
+  stroke: #F2B8C0;
+  stroke-width: 3;
+  stroke-linecap: round;
+  vector-effect: non-scaling-stroke;
+}
+
+.shop .hero-text .hero-tagline-zh {
+  margin: 26px 0 0;
+  font-family: var(--font-serif);
+  font-size: clamp(16px, 1.5vw, 19px);
+  letter-spacing: .14em;
+  line-height: 1.8;
+  color: var(--text-soft);
+  text-wrap: balance;
+}
+
+.shop .hero-text .hero-label {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  margin: 44px 0 0;
+  font-family: var(--font-serif);
+  font-weight: 600;
+  font-size: 12.5px;
+  letter-spacing: .3em;
+  color: var(--accent);
+}
+
+.hero-label::before {
+  content: "";
+  flex: none;
+  width: 36px;
+  height: 1px;
+  background: currentColor;
+  transform-origin: left center;
+}
+
+.shop .hero-text .hero-poem {
+  max-width: 30em;
+  margin: 18px 0 0;
+  font-size: 17px;
+  line-height: 2;
+  color: var(--text-soft);
+}
+
+.hero-poem span {
+  display: block;
+}
+
+.shop .hero-text .hero-sign {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px 14px;
+  margin: 24px 0 0;
+  font-family: var(--font-serif);
+  font-size: 12px;
+  letter-spacing: .32em;
+  color: var(--text-dim);
+}
+
+.hero-sign .fl {
+  flex: none;
+  color: var(--t-medium);
+}
+
+.hero-sign .fl:last-of-type {
+  color: var(--honey);
+}
+
+/* 小花與花瓣 */
+.hero-petals {
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  overflow: hidden;
+  pointer-events: none;
+  display: none;
+}
+
+.hero-petals i {
+  position: absolute;
+  top: -24px;
+  left: var(--x);
+  width: var(--s);
+  height: calc(var(--s) * 1.45);
+  border-radius: 80% 0 80% 0;
+  background: #F4A9B8;
+  opacity: 0;
+}
+
+/* ---------- 右側插畫 ---------- */
+.hero-art {
+  flex: 0 1 580px;
+  max-width: 580px;
+}
+
+.shopfront-img {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+/* 吊燈的暖光：圖片上方一層很淡的光暈 */
+.stage-glow {
+  position: absolute;
+  left: 37.6%;
+  top: 26%;
+  width: 26%;
+  aspect-ratio: 1;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(255, 226, 150, .5) 0%, rgba(255, 226, 150, 0) 66%);
+  pointer-events: none;
+  opacity: .7;
+}
+
+/* ---------- 自我介紹 ---------- */
+.home-intro {
+  margin: 8px 0 72px;
+}
+
+.intro-fl {
+  display: block;
+  margin: 0 0 14px;
+  color: var(--t-medium);
+}
+
+.home-intro .home-side h2 {
+  font-size: 30px;
+  line-height: 1.6;
+  text-wrap: balance;
+}
+
+.intro-body {
+  max-width: 36em;
+}
+
+.intro-body p {
+  margin: 0 0 18px;
+  font-size: 16.5px;
+  line-height: 2.05;
+  color: var(--text-soft);
+}
+
+.intro-body .intro-closing {
+  display: flex;
+  align-items: baseline;
+  gap: 12px;
+  margin: 34px 0 0;
+  padding-top: 26px;
+  border-top: 2px dotted var(--line-strong);
+  font-family: var(--font-serif);
+  font-size: 21px;
+  line-height: 1.7;
+  letter-spacing: .06em;
+  color: var(--text);
+}
+
+.intro-closing .fl {
+  flex: none;
+  align-self: center;
+  color: var(--t-medium);
+}
+
+@media (max-width: 640px) {
+  .shop .hero-text .hero-tagline-zh { margin-top: 20px; font-size: 15px; letter-spacing: .06em; text-wrap: balance; }
+  .shop .hero-text .hero-label { margin-top: 34px; gap: 10px; letter-spacing: .14em; font-size: 11px; }
+  .hero-label::before { width: 22px; }
+  .shop .hero-text .hero-poem { font-size: 16px; }
+  .shop .hero-text .hero-sign { letter-spacing: .12em; font-size: 11px; gap: 6px 10px; }
+  .home-intro { margin-bottom: 48px; }
+  .home-intro .home-side h2 { font-size: 24px; }
+  .intro-body p { font-size: 16px; }
+  .intro-body .intro-closing { font-size: 18px; }
+}
+
+/* ---------- 動畫（只在沒有開啟「減少動態效果」時） ---------- */
+@media (prefers-reduced-motion: no-preference) {
+  @keyframes hl-rise {
+    from { opacity: 0; transform: translateY(16px); }
+    to { opacity: 1; transform: none; }
+  }
+  @keyframes hl-art {
+    from { opacity: 0; transform: translateY(22px) scale(.985); }
+    to { opacity: 1; transform: none; }
+  }
+  @keyframes hl-draw {
+    from { stroke-dashoffset: 1; }
+    to { stroke-dashoffset: 0; }
+  }
+  @keyframes hl-line {
+    from { transform: scaleX(0); }
+    to { transform: scaleX(1); }
+  }
+  @keyframes hl-spin-a { to { transform: rotate(360deg); } }
+  @keyframes hl-spin-b { to { transform: rotate(-360deg); } }
+  @keyframes hl-bloom {
+    0% { transform: scale(0) rotate(-60deg); }
+    70% { transform: scale(1.22) rotate(8deg); }
+    100% { transform: scale(1) rotate(0); }
+  }
+  @keyframes hl-fall {
+    0% { opacity: 0; transform: translate3d(0, 0, 0) rotate(0); }
+    10% { opacity: .55; }
+    50% { transform: translate3d(var(--w), 46vh, 0) rotate(140deg); }
+    90% { opacity: .45; }
+    100% { opacity: 0; transform: translate3d(calc(var(--w) * -.6), 92vh, 0) rotate(300deg); }
+  }
+
+  /* 首頁載入：由上而下依序浮現 */
+  .hl-in {
+    animation: hl-rise .9s cubic-bezier(.2, .7, .2, 1) backwards;
+    animation-delay: calc(var(--i, 0) * 110ms + 120ms);
+  }
+
+  .hero-art {
+    animation: hl-art 1.1s cubic-bezier(.2, .7, .2, 1) .3s backwards;
+  }
+
+  /* 「sweetness」的手繪底線：寫完標語才畫出來 */
+  .hl-wave path {
+    stroke-dasharray: 1;
+    stroke-dashoffset: 0;
+    animation: hl-draw 1s cubic-bezier(.5, 0, .2, 1) 1.1s backwards;
+  }
+
+  .hero-label::before {
+    animation: hl-line .8s cubic-bezier(.2, .7, .2, 1) calc(var(--i, 0) * 110ms + 300ms) backwards;
+  }
+
+  /* 插畫：像放在窗邊一樣，非常輕地上下浮動；吊燈光暈慢慢呼吸 */
+  @keyframes hl-float {
+    0%, 100% { transform: translateY(0); }
+    50% { transform: translateY(-7px); }
+  }
+  @keyframes hl-glow {
+    0%, 100% { opacity: .5; transform: scale(1); }
+    50% { opacity: .95; transform: scale(1.1); }
+  }
+  .stage {
+    animation: hl-float 8s ease-in-out 1.4s infinite;
+  }
+  .stage-glow {
+    animation: hl-glow 5.5s ease-in-out infinite;
+  }
+
+  /* 結尾的兩朵小花慢慢轉 */
+  .hero-sign .fl {
+    animation: hl-spin-a 26s linear infinite;
+  }
+  .hero-sign .fl:last-of-type {
+    animation-name: hl-spin-b;
+  }
+
+  /* 花瓣：很淡、很慢，不蓋住文字 */
+  .hero-petals {
+    display: block;
+  }
+  .hero-petals i {
+    animation: hl-fall var(--t) linear var(--d) infinite;
+  }
+
+  /* 捲動到才浮現（js 加上 .in；沒有 js 時完全不隱藏） */
+  .js .rv:not(.in) {
+    opacity: 0;
+    transform: translateY(18px);
+  }
+  .rv.in {
+    animation: hl-rise .85s cubic-bezier(.2, .7, .2, 1) backwards;
+    animation-delay: calc(var(--d, 0) * 90ms);
+  }
+  .intro-closing.in .fl {
+    animation: hl-bloom .8s cubic-bezier(.3, 1.4, .5, 1) calc(var(--d, 0) * 90ms + 350ms) backwards;
+  }
+  .home-side.in .intro-fl {
+    animation: hl-bloom .8s cubic-bezier(.3, 1.4, .5, 1) .2s backwards;
+  }
+
+  /* 滑鼠移上去：文字連結的底線慢慢變色 */
+  .btn-text {
+    transition: color .25s, border-color .25s;
+  }
+}
+
+@media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
+  .btn-text:hover {
+    border-color: var(--accent);
+  }
+}
