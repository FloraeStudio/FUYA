--- /dev/null
+++ b/tools/fetch-home.js
@@ -0,0 +1,56 @@
+#!/usr/bin/env node
+'use strict';
+
+// 建置前從後台把「首頁文字」抓下來，寫進 source/_data/site.yml。
+//   node tools/fetch-home.js
+//
+// 後台網址的來源（依序）：環境變數 FUYA_ADMIN_URL → source/_data/commission.yml 裡的 api_url。
+// 安全設計：
+//  - 後台還沒存過首頁文字（回傳 null）→ 不動 site.yml，沿用 repo 裡的內容。
+//  - 抓不到後台（斷線、後台掛掉）→ 不動 site.yml，印出警告後繼續建置。
+
+const fs = require('fs');
+const path = require('path');
+
+const FILE = path.join(__dirname, '..', 'source', '_data', 'site.yml');
+const KEYS = ['hero_tagline', 'hero_tagline_zh', 'hero_eyebrow', 'hero_text', 'hero_sign', 'intro_title', 'intro_text', 'intro_closing', 'status_line'];
+
+function adminUrl() {
+  if (process.env.FUYA_ADMIN_URL) return process.env.FUYA_ADMIN_URL.replace(/\/+$/, '');
+  try {
+    const yml = fs.readFileSync(path.join(__dirname, '..', 'source', '_data', 'commission.yml'), 'utf8');
+    const m = yml.match(/^api_url:\s*['"]?([^'"\s#]*)['"]?/m);
+    if (m && m[1]) return m[1].replace(/\/+$/, '');
+  } catch (e) {}
+  return '';
+}
+
+// 單行：JSON 字串同時是合法的 YAML 雙引號字串。多行：用 |- 區塊，每行縮排兩格。
+function yamlValue(key, v) {
+  const s = String(v == null ? '' : v);
+  if (!s.includes('\n')) return key + ': ' + JSON.stringify(s);
+  return key + ': |-\n' + s.split('\n').map((l) => '  ' + l).join('\n');
+}
+
+(async () => {
+  const base = adminUrl();
+  if (!base) return console.warn('！沒有設定後台網址，略過抓首頁文字，沿用 site.yml。');
+  let home;
+  try {
+    const res = await fetch(base + '/api/home?t=' + Date.now(), { signal: AbortSignal.timeout(30000), headers: { 'Cache-Control': 'no-cache' } });
+    if (!res.ok) throw new Error('HTTP ' + res.status);
+    home = (await res.json()).home;
+  } catch (e) {
+    return console.warn('！連不上後台（' + e.message + '），沿用 site.yml 裡的首頁文字。');
+  }
+  if (!home) return console.log('後台還沒存過首頁文字，沿用 site.yml。');
+
+  const out = [
+    '# 這個檔案會在每次建置時被後台（fuya-admin →「首頁」分頁）的內容覆蓋。',
+    '# 要改首頁文字請到後台改；直接改這裡的內容，下次建置後會被後台的版本蓋掉。',
+    '',
+    ...KEYS.map((k) => yamlValue(k, home[k]))
+  ];
+  fs.writeFileSync(FILE, out.join('\n') + '\n');
+  console.log('已用後台的首頁文字更新 site.yml');
+})();
